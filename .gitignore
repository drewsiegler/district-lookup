.venv/
__pycache__/
*.pyc
.DS_Store

# Real contact lists never belong in a public repo. The app window keeps
# results in memory and only hands them over as downloads, and the command
# line writes them next to your input list rather than in here — these
# patterns are a backstop in case a list or its results land in the project
# folder anyway.
*.csv
!data/people_contacts_example.csv
data/geocode_cache.sqlite

# Built from data/raw_geojson/ by scripts/build_gpkg.py. Ignored so the repo
# doesn't carry a new multi-megabyte copy in its history on every rebuild;
# data/districts/ (what the app reads) is committed instead.
*.gpkg

# PyInstaller's output when the installed app is built locally
# (packaging/district_lookup.spec); releases are built by GitHub instead.
/build/
/dist/
