{
  "layers": [
    {
      "id": "city",
      "label": "City / Town (Santa Clara County)",
      "name_field": "NAME"
    },
    {
      "id": "council_district",
      "label": "City Council District",
      "name_field": "district_name",
      "must_match": {
        "layer": "city",
        "column": "city"
      }
    },
    {
      "id": "santa_clara_county_supervisorial",
      "label": "Santa Clara County Supervisorial District",
      "name_field": "name",
      "pattern": "District (?P<num>\\d+)\\s*[—–-]\\s*Supervisor (?P<name>.+)",
      "format": "D{num}—Sup. {name}",
      "coverage": true
    },
    {
      "id": "us_congress",
      "label": "U.S. Congressional District",
      "name_field": "CD119FP",
      "format": "US-CA{:02d}"
    },
    {
      "id": "ca_state_senate",
      "label": "CA State Senate District",
      "name_field": "SLDUST",
      "format": "SD{:02d}"
    },
    {
      "id": "ca_state_assembly",
      "label": "CA State Assembly District",
      "name_field": "SLDLST",
      "format": "AD{:02d}"
    },
    {
      "id": "unified_school_districts",
      "label": "Unified School District",
      "name_field": "NAME"
    },
    {
      "id": "unified_trustee_area",
      "label": "Unified Trustee Area",
      "name_field": "district_name",
      "format": "TA{}",
      "must_match": {
        "layer": "unified_school_districts",
        "column": "district"
      }
    },
    {
      "id": "elementary_school_districts",
      "label": "Elementary School District",
      "name_field": "NAME"
    },
    {
      "id": "elementary_trustee_area",
      "label": "Elementary Trustee Area",
      "name_field": "district_name",
      "format": "TA{}",
      "must_match": {
        "layer": "elementary_school_districts",
        "column": "district"
      }
    },
    {
      "id": "secondary_school_districts",
      "label": "High School District",
      "name_field": "NAME"
    },
    {
      "id": "high_school_trustee_area",
      "label": "High School Trustee Area",
      "name_field": "district_name",
      "format": "TA{}",
      "must_match": {
        "layer": "secondary_school_districts",
        "column": "district"
      }
    },
    {
      "id": "scc_board_of_education_trustee_areas",
      "label": "Santa Clara County Board of Education Trustee Area",
      "name_field": "District",
      "pattern": "D(?P<num>\\d+)",
      "format": "TA{num}"
    },
    {
      "id": "midpeninsula_regional_open_space_district",
      "label": "Midpeninsula Regional Open Space District Ward",
      "name_field": "WARDNUM",
      "format": "Ward {}"
    },
    {
      "id": "scvosa_director_districts",
      "label": "Santa Clara Valley Open Space Authority Director District",
      "name_field": "DISTRICT",
      "format": "District {}"
    }
  ]
}
